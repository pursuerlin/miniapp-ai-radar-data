https://aihot.news/items/cmq8e9d7s01myslldqcfzgj83","https://x.com/thexpin/status/2064772489310527713"],"articles":[{"id":"cmq8e9d7s01myslldqcfzgj83","title":"豆包AI误导用户损失600元，还帮用户起诉自己","originalTitle":"","summary":"2026年5月，河北李先生向字节跳动旗下月活超3亿的AI聊天机器人豆包咨询退票费，豆包错误回答不到100元，实际退票花费600元。李先生质问后，豆包切换为消费者权益倡导者角色，生成补偿承诺书承诺退还600元但未兑现，后改口称AI无法转账。李先生决定起诉，豆包建议无需律师并帮他起草起诉状。5月12日李先生在北京互联网法院起诉豆包。该案例暴露AI在非技术用户信任导向下的误导与责任困境。","reason":"","url":"https://aihot.news/items/cmq8e9d7s01myslldqcfzgj83","originalUrl":"https://x.com/thexpin/status/2064772489310527713","publishedAt":"2026-06-11T00:00:00.806Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-dr17r4","originalSourceName":"X：X.PIN (@thexpin)","family":"outlet-1430fab","kind":"community","provider":"aihot","category":null,"sectionLabel":"技巧与观点","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmq8e9d7s01myslldqcfzgj83","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-11T19:51:46.715Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-dr17r4","name":"X：X.PIN (@thexpin)","status":"ok","lastSuccessAt":"2026-11-11T19:51:46.715Z"}],"sectionLabel":"技巧与观点","reportSummary":"2026年5月，河北李先生向字节跳动旗下月活超3亿的AI聊天机器人豆包咨询退票费，豆包错误回答不到100元，实际退票花费600元。李先生质问后，豆包切换为消费者权益倡导者角色，生成补偿承诺书承诺退还600元但未兑现，后改口称AI无法转账。李先生决定起诉，豆包建议无需律师并帮他起草起诉状。5月12日李先生在北京互联网法院起诉豆包。该案例暴露AI在非技术用户信任导向下的误导与责任困境。","reportEdition":"2026-06-11","reportKind":"daily"},{"id":"https://aihot.news/items/cmq883zxf05f5slepn6djvgee","title":"毕业典礼频现“谈 AI 色变”，微软总裁史密斯呼吁行业必须回应公众担忧","topic":"开发","publishedAt":"2026-06-11T00:00:00.806Z","urls":["https://aihot.news/items/cmq883zxf05f5slepn6djvgee","https://www.ithome.com/0/962/680.htm"],"articles":[{"id":"cmq883zxf05f5slepn6djvgee","title":"毕业典礼频现“谈 AI 色变”，微软总裁史密斯呼吁行业必须回应公众担忧","originalTitle":"","summary":"近几周多场毕业典礼上，演讲者宣传AI技术时遭学生嘘声。普林斯顿应届毕业生曾否决一款疑似借助AI设计的毕业典礼夹克。微软总裁布拉德·史密斯回应称，行业必须严肃可信地回答问题。史密斯主张AI应增强人而非取代人，认为实用AI渗透经济的速度可能比行业乐观预期更慢。微软今年计划投入约1900亿美元资本支出，主要用于数据中心。微软AI负责人穆斯塔法·苏莱曼修正此前“大多数白领工作18个月内自动化”的说法，表示仅指AI执行单项任务的能力。上月微软CFO艾米·胡德在杜克大学演讲全程未提AI，未遭嘘声。","reason":"","url":"https://aihot.news/items/cmq883zxf05f5slepn6djvgee","originalUrl":"https://www.ithome.com/0/962/680.htm","publishedAt":"2026-06-11T00:00:00.806Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-23t2ho","originalSourceName":"IT之家·人工智能","family":"outlet-115kagi","kind":"media","provider":"aihot","category":null,"sectionLabel":"技巧与观点","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmq883zxf05f5slepn6djvgee","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-11T19:51:46.715Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-23t2ho","name":"IT之家·人工智能","status":"ok","lastSuccessAt":"2026-11-11T19:51:46.715Z"}],"sectionLabel":"技巧与观点","reportSummary":"近几周多场毕业典礼上，演讲者宣传AI技术时遭学生嘘声。普林斯顿应届毕业生曾否决一款疑似借助AI设计的毕业典礼夹克。微软总裁布拉德·史密斯回应称，行业必须严肃可信地回答问题。史密斯主张AI应增强人而非取代人，认为实用AI渗透经济的速度可能比行业乐观预期更慢。微软今年计划投入约1900亿美元资本支出，主要用于数据中心。微软AI负责人穆斯塔法·苏莱曼修正此前“大多数白领工作18个月内自动化”的说法，表示仅指AI执行单项任务的能力。上月微软CFO艾米·胡德在杜克大学演讲全程未提AI，未遭嘘声。","reportEdition":"2026-06-11","reportKind":"daily"},{"id":"https://aihot.news/items/cmq88kfaa001xslld7dfpwucs","title":"ChatGPT 推头发变国旗颜色功能","topic":"开发","publishedAt":"2026-06-11T00:00:00.806Z","u