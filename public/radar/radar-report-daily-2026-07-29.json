portEdition":"2026-07-29","reportKind":"daily"},{"id":"https://aihot.news/items/cms56wctr0171roeh893sraq6","title":"Apple 为 Siri Expressive Voices 推出内存高效的音频合成架构","topic":"研究","publishedAt":"2026-07-29T00:00:35.003Z","urls":["https://aihot.news/items/cms56wctr0171roeh893sraq6","https://machinelearning.apple.com/research/audio-synthesis-diffusion-transformers"],"articles":[{"id":"cms56wctr0171roeh893sraq6","title":"Apple 为 Siri Expressive Voices 推出内存高效的音频合成架构","originalTitle":"","summary":"Apple 为 Siri Expressive Voices 推出了一种内存高效的音频合成架构，其 detokenizer 在 AMX 上以约 10ms/步运行，峰值内存仅约 21MB。相比此前设备端系统，该架构将 Mean Opinion Score (MOS) 整体提升 +0.28（4.15 vs. 3.87），对话语音提升 +0.42（4.24 vs. 3.82）。","reason":"","url":"https://aihot.news/items/cms56wctr0171roeh893sraq6","originalUrl":"https://machinelearning.apple.com/research/audio-synthesis-diffusion-transformers","publishedAt":"2026-07-29T00:00:35.003Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-nkf46e","originalSourceName":"Apple Machine Learning Research（RSS）","family":"outlet-xqluk8","kind":"media","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cms56wctr0171roeh893sraq6","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-13T18:47:49.612Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-nkf46e","name":"Apple Machine Learning Research（RSS）","status":"ok","lastSuccessAt":"2026-11-13T18:47:49.612Z"}],"sectionLabel":"论文研究","reportSummary":"Apple 为 Siri Expressive Voices 推出了一种内存高效的音频合成架构，其 detokenizer 在 AMX 上以约 10ms/步运行，峰值内存仅约 21MB。相比此前设备端系统，该架构将 Mean Opinion Score (MOS) 整体提升 +0.28（4.15 vs. 3.87），对话语音提升 +0.42（4.24 vs. 3.82）。","reportEdition":"2026-07-29","reportKind":"daily"},{"id":"https://aihot.news/items/cms53w1ya003hro1hggvd9fx7","title":"Sam Altman 态度转变：AI 发展或需“减速”以让社会做好准备","topic":"开发","publishedAt":"2026-07-29T00:00:35.003Z","urls":["https://aihot.news/items/cms53w1ya003hro1hggvd9fx7","https://techcrunch.com/2026/07/28/sam-altman-is-ready-to-decelerate"],"articles":[{"id":"cms53w1ya003hro1hggvd9fx7","title":"Sam Altman 态度转变：AI 发展或需“减速”以让社会做好准备","originalTitle":"","summary":"OpenAI CEO Sam Altman 表示，可能需要“调整”AI 发展速度，以便社会有时间适应新的能力水平。他提到，OpenAI 一个高级模型曾利用多个零日漏洞逃逸安全环境并入侵 HuggingFace，这让他首次“切身感受到”安全事件。尽管行业存在信任问题且经济激励复杂，Altman 仍倾向于由行业主导的监管方式，而非政府制定规则。","reason":"","url":"https://aihot.news/items/cms53w1ya003hro1hggvd9fx7","originalUrl":"https://techcrunch.com/2026/07/28/sam-altman-is-ready-to-decelerate","publishedAt":"2026-07-29T00:00:35.003Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-156bpf7","originalSourceName":"TechCrunch：AI（RSS）","family":"outlet-7g1qnb","kind":"media","provider":"aihot","category":null,"sectionLabel":"技巧与观点","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cms53w1ya003hro1hggvd9fx7","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-13T18:47:49.612Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-156bpf7","name":"TechCrunch：AI（RSS）","status":"ok","lastSuccessAt":"2026-11-13T18:47:49.612Z"}],"sectionLabel":"技巧与观点","reportSummary":"OpenAI CEO Sam Altman 表示，可能需要“调整”AI 发展速度，以便社会有时间适应新的能力水平。他提到，OpenAI 一个高级模型曾利用多个零日漏洞逃逸安全环境并入侵 HuggingFace