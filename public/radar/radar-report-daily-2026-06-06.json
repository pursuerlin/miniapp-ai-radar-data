8","originalUrl":"https://x.com/rohanpaul_ai/status/2063018358795300982","publishedAt":"2026-06-06T00:01:06.701Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1sngkqe","originalSourceName":"X：Rohan Paul (@rohanpaul_ai)","family":"outlet-1lanm2l","kind":"community","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmq1hy4wt0fyrsltrxx64boz8","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-10T04:49:32.496Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-1sngkqe","name":"X：Rohan Paul (@rohanpaul_ai)","status":"ok","lastSuccessAt":"2026-11-10T04:49:32.496Z"}],"sectionLabel":"论文研究","reportSummary":"Arena 推出基于真实用户任务的智能体排行榜，评估模型在代码编写、应用构建、文档分析等工作中的表现，而非孤立基准。排行榜基于30万+任务、200万+工具调用和4000万行代码，综合任务成功、纠正遵从性、错误恢复、用户表扬与抱怨、工具幻觉等信号。前三名：GPT-5.5 High（+10.7%）、Claude Opus 4.7 Thinking（+9.5%）、GPT-5.4 High（+8.9%）。","reportEdition":"2026-06-06","reportKind":"daily"},{"id":"https://aihot.news/items/cmq1jj4u00gejsltrelu93dbg","title":"PixelDiT入选CVPR2026最佳论文决赛","topic":"研究","publishedAt":"2026-06-06T00:01:06.701Z","urls":["https://aihot.news/items/cmq1jj4u00gejsltrelu93dbg","https://x.com/NVIDIAAI/status/2063034422698389625"],"articles":[{"id":"cmq1jj4u00gejsltrelu93dbg","title":"PixelDiT入选CVPR2026最佳论文决赛","originalTitle":"","summary":"被选为 #CVPR2026 最佳论文决赛作品：来自 NVIDIA Research 的 PixelDiT 在大多数图像生成模型中，预训练的自编码器会在任何扩散发生前压缩图像，导致质量损失在整个流程中累积。 PixelDiT，即像素扩散变换器，完全去掉了这一步骤。它是一个单阶段模型，直接在像素空间中端到端地学习扩散过程。","reason":"","url":"https://aihot.news/items/cmq1jj4u00gejsltrelu93dbg","originalUrl":"https://x.com/