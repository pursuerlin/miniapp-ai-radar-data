y","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cms6xa31u02nlrouq0wkhylfp","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-12T14:49:43.047Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-i4gq4t","name":"X：腾讯混元 (@TencentHunyuan)","status":"ok","lastSuccessAt":"2026-11-12T14:49:43.047Z"}],"sectionLabel":"论文研究","reportSummary":"腾讯混元借助研究智能体Hyra及Hy3模型，构造出整数集A使|A+A|与|A-A|的指数比精确达到2，解决了自1969年以来悬而未决的极值问题。此前50余年最佳构造仅略超1.1，新成果证明最优指数即为2。论文及形式化证明已公开。","reportEdition":"2026-07-31","reportKind":"daily"},{"id":"https://aihot.news/items/cms7t8rqq034propbg9bdfyg4","title":"降维遇见网络科学：UMAP的kNN图在数据理解中的应用","topic":"研究","publishedAt":"2026-07-31T00:00:06.150Z","urls":["https://aihot.news/items/cms7t8rqq034propbg9bdfyg4","https://machinelearning.apple.com/research/umap-knn-graph-sensemaking"],"articles":[{"id":"cms7t8rqq034propbg9bdfyg4","title":"降维遇见网络科学：UMAP的kNN图在数据理解中的应用","originalTitle":"","summary":"Apple研究团队展示了UMAP内部kNN图在数据理解中的潜力，该图在原始高维空间编码数据流形。将PageRank、k-core分解和聚类系数等图算法应用于该图，可识别代表性数据点、揭示密集核心与稀疏边缘。在MNIST和Fashion MNIST上的评估表明，这些方法与k-medoids、HDBSCAN等专用方法具有竞争力或互补性。","reason":"","url":"https://aihot.news/items/cms7t8rqq034propbg9bdfyg4","originalUrl":"https://machinelearning.apple.com/research/umap-knn-graph-sensemaking","publishedAt":"2026-07-31T00:00:06.150Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-nkf46e","originalSourceName":"Apple Machine Learning Research（RSS）","family":"outlet-xqluk8","kind":"media","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":f