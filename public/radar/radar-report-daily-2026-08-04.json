-04T00:00:24.229Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-15u5q96","originalSourceName":"The Verge：AI（RSS）","family":"outlet-1q2yxza","kind":"media","provider":"aihot","category":null,"sectionLabel":"行业动态","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmsdkgj9m00hnro0ocrleteo0","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-06T06:48:53.823Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-15u5q96","name":"The Verge：AI（RSS）","status":"ok","lastSuccessAt":"2026-11-06T06:48:53.823Z"}],"sectionLabel":"行业动态","reportSummary":"欧盟《人工智能法案》下的新透明度义务于 8 月 2 日生效，要求公司披露用户何时与 AI 模型互动，并为合成音视频和文本添加机器可读标记。欧盟还推出了一套可选的 AI 披露标签供平台采用，但标注要求本身是强制性的。违规公司面临最高 1500 万欧元（约 1720 万美元）或全球年营业额 3% 的罚款，8 月 2 日前推出的模型有 4 个月宽限期。","reportEdition":"2026-08-04","reportKind":"daily"},{"id":"https://aihot.news/items/cmsdbpohx17wzroeu3vca6gqg","title":"Databricks 完成对 Panther 的收购，加速安全湖仓时代","topic":"行业","publishedAt":"2026-08-04T00:00:24.229Z","urls":["https://aihot.news/items/cmsdbpohx17wzroeu3vca6gqg","https://www.databricks.com/blog/databricks-completes-acquisition-panther-accelerating-security-lakehouse-era"],"articles":[{"id":"cmsdbpohx17wzroeu3vca6gqg","title":"Databricks 完成对 Panther 的收购，加速安全湖仓时代","originalTitle":"","summary":"Databricks 宣布正式完成对安全数据平台 Panther 的收购，旨在加速安全湖仓（Security Lakehouse）时代。此次收购将 Panther 的安全分析能力整合进 Databricks 平台，帮助企业在统一的数据架构上运行安全运营与威胁检测工作负载。具体交易条款未披露。","reason":"","url":"https://aihot.news/items/cmsdbpohx17wzroeu3vca6gqg","originalUrl":"https://www.databricks.com/blog/databricks-completes-acquisition-panther-accelerating-security