https://x.com/cb_doge/status/2055280665583898691"],"articles":[{"id":"cmp6yru3g061kslnzz7uthrl7","title":"X平台开源“For You”信息流推荐算法","originalTitle":"","summary":"X平台在GitHub开源了其“For You”信息流的最新推荐算法。该算法融合来自已关注账号的内容和通过相似性搜索发现的网络外内容，并利用基于Grok架构的Phoenix Transformer模型进行统一评分。模型通过分析用户近期互动，同时预测点赞、回复、转发等多种互动概率，并综合成最终相关性分数。排序过程包括候选内容收集、上下文信息补充、AI模型评分、多样性调整及垃圾信息过滤等步骤。此次开源提供了完整的可运行管道、预训练模型、内容理解服务及内置广告混合模块，核心计算完全由Transformer模型驱动。","reason":"","url":"https://aihot.news/items/cmp6yru3g061kslnzz7uthrl7","originalUrl":"https://x.com/cb_doge/status/2055280665583898691","publishedAt":"2026-05-16T00:00:00.584Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-cpgbcv","originalSourceName":"X：cb_doge (@cb_doge)","family":"outlet-5zs72o","kind":"community","provider":"aihot","category":null,"sectionLabel":"产品发布/更新","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmp6yru3g061kslnzz7uthrl7","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-06T14:49:01.513Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-cpgbcv","name":"X：cb_doge (@cb_doge)","status":"ok","lastSuccessAt":"2026-11-06T14:49:01.513Z"}],"sectionLabel":"产品发布/更新","reportSummary":"X平台在GitHub开源了其“For You”信息流的最新推荐算法。该算法融合来自已关注账号的内容和通过相似性搜索发现的网络外内容，并利用基于Grok架构的Phoenix Transformer模型进行统一评分。模型通过分析用户近期互动，同时预测点赞、回复、转发等多种互动概率，并综合成最终相关性分数。排序过程包括候选内容收集、上下文信息补充、AI模型评分、多样性调整及垃圾信息过滤等步骤。此次开源提供了完整的可运行管道、预训练模型、内容理解服务及内置广告混合模块，核心计算完全由Transformer模型驱动。","reportEdition":"2026-05-16","reportKind":"daily"},{"id":"https://aihot.news/items/cmp72z8pw0715slnz6cpkuxls","title":"OpenRouter BYOK三大升级 支持多密钥轮换","topic":"应用","p