014"],"articles":[{"id":"pqpqgxyiu4qyu86fbljd726v9","title":"MIT团队用机器学习修正误差，将两到六周天气预报准确率翻倍","originalTitle":"","summary":"MIT研究人员团队在Nature发表论文，提出一个机器学习后处理层，通过从历史数据中学习现有预报模型的错误并修正其输出，将两周到六周范围的预报准确率翻倍。该模型在ECMWF的季节间预报竞赛中获第一名，首次在该时间范围内稳定超过气候学平均值，并显著改善洪水、寒潮等极端天气事件的预测；模型开源、低成本、可附加于任意预报模型，肯尼亚气象部门已接洽用于改进季风季预报。","reason":"","url":"https://aihot.news/items/pqpqgxyiu4qyu86fbljd726v9","originalUrl":"https://news.mit.edu/2026/researchers-improve-weather-forecasts-looking-two-six-weeks-out-1014","publishedAt":"2026-10-15T00:00:30.649Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-862tj4","originalSourceName":"MIT News（RSS）","family":"outlet-1obvqmj","kind":"media","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/pqpqgxyiu4qyu86fbljd726v9","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-14T00:48:54.560Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-862tj4","name":"MIT News（RSS）","status":"ok","lastSuccessAt":"2026-11-14T00:48:54.560Z"}],"sectionLabel":"论文研究","reportSummary":"MIT研究人员团队在Nature发表论文，提出一个机器学习后处理层，通过从历史数据中学习现有预报模型的错误并修正其输出，将两周到六周范围的预报准确率翻倍。该模型在ECMWF的季节间预报竞赛中获第一名，首次在该时间范围内稳定超过气候学平均值，并显著改善洪水、寒潮等极端天气事件的预测；模型开源、低成本、可附加于任意预报模型，肯尼亚气象部门已接洽用于改进季风季预报。","reportEdition":"2026-10-15","reportKind":"daily"},{"id":"https://aihot.news/items/whbmvotra7659u98jmj00oegi","title":"Claude Code 空闲压缩从摘要继续，可用 idleCompaction 关闭并自定义阈值","topic":"开发","publishedAt":"2026-10-15T00:00:30.649Z","urls":["https://aihot.news/items/whbmvotra7659u98jmj00oegi","https://x.com/lydiahallie/status/211048484