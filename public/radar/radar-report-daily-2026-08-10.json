ourceStates":[{"id":"aihot-pi6ank","name":"X：Boris Cherny (@bcherny)","status":"ok","lastSuccessAt":"2026-11-05T04:01:34.769Z"}],"sectionLabel":"技巧与观点","reportSummary":"Anthropic 的 Boris Cherny 表示，通过模型训练已基本解决 Claude 模型在实际使用中的提示注入威胁。独立研究者的基准测试显示，叠加模型训练、输入探测和意图分类器等多层防御后，未见过的间接提示注入攻击成功率可降至约 0。Claude Code 的 auto 模式将于下周默认开启。","reportEdition":"2026-08-10","reportKind":"daily"},{"id":"https://aihot.news/items/cmslhy76p03hdroo0l8dsaskb","title":"用DistilBERT LoRA与TF-IDF基线做IMDb情感分析：校准、可解释性与半监督学习","topic":"开发","publishedAt":"2026-08-10T00:00:52.089Z","urls":["https://aihot.news/items/cmslhy76p03hdroo0l8dsaskb","https://www.marktechpost.com/2026/08/09/imdb-sentiment-analysis-with-distilbert-lora-tf-idf-baselines-calibration-interpretability-robustness-testing-and-semi-supervised-learning"],"articles":[{"id":"cmslhy76p03hdroo0l8dsaskb","title":"用DistilBERT LoRA与TF-IDF基线做IMDb情感分析：校准、可解释性与半监督学习","originalTitle":"","summary":"本教程基于Stanford IMDb数据集构建端到端情感分析流程，对比TF-IDF逻辑回归基线与LoRA微调的DistilBERT。模型评估涵盖准确率、macro-F1、ROC-AUC及期望校准误差，并分析置信错误、长度影响与词级遮挡显著性。最后利用未标注IMDb数据做置信度伪标注，比较半监督模型与基线，保存合并后的Transformer用于推理。","reason":"","url":"https://aihot.news/items/cmslhy76p03hdroo0l8dsaskb","originalUrl":"https://www.marktechpost.com/2026/08/09/imdb-sentiment-analysis-with-distilbert-lora-tf-idf-baselines-calibration-interpretability-robustness-testing-and-semi-supervised-learning","publishedAt":"2026-08-10T00:00:52.089Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1myrib4","originalSourceName":"MarkTechPost（RSS）","family":"outlet-a3l49l","kind":"media","provider":"aihot","category":null,"sectionLabel":"技巧与观点","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmslhy76p03hdroo0l8dsaskb","licenseU