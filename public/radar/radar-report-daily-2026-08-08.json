-capabilities"],"articles":[{"id":"cmsj6bawu00sqroo5obcdov2f","title":"OpenAI 发布 Astra 初步网络安全评估与防护强化措施","originalTitle":"","summary":"OpenAI 公布了 Astra 的初步网络安全评估结果，并介绍了为强化安全防护与控制所采取的措施。此次评估聚焦于 Astra 在关键网络能力方面的表现，相关安全更新旨在应对前沿领域的潜在风险。","reason":"","url":"https://aihot.news/items/cmsj6bawu00sqroo5obcdov2f","originalUrl":"https://openai.com/index/responding-next-frontier-critical-cyber-capabilities","publishedAt":"2026-08-08T00:01:00.022Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1wljf9q","originalSourceName":"OpenAI：官网动态（RSS · 排除企业/客户案例）","family":"openai","kind":"official","provider":"aihot","category":null,"sectionLabel":"行业动态","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmsj6bawu00sqroo5obcdov2f","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-07T20:48:56.475Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-1wljf9q","name":"OpenAI：官网动态（RSS · 排除企业/客户案例）","status":"ok","lastSuccessAt":"2026-11-07T20:48:56.475Z"}],"sectionLabel":"行业动态","reportSummary":"OpenAI 公布了 Astra 的初步网络安全评估结果，并介绍了为强化安全防护与控制所采取的措施。此次评估聚焦于 Astra 在关键网络能力方面的表现，相关安全更新旨在应对前沿领域的潜在风险。","reportEdition":"2026-08-08","reportKind":"daily"},{"id":"https://aihot.news/items/cmsiys4dz1yqironkuitnfi7t","title":"斯坦福与 Arc Institute 用 AI 设计全新病毒基因组，16 种在实验室成功杀死细菌","topic":"研究","publishedAt":"2026-08-08T00:01:00.022Z","urls":["https://aihot.news/items/cmsiys4dz1yqironkuitnfi7t","https://the-decoder.com/stanford-and-arc-institute-scientists-used-ai-to-design-new-viruses-that-killed-bacteria-in-the-lab"],"articles":[{"id":"cmsiys4dz1yqironkuitnfi7t","title":"斯坦福与 Arc Institute 用 AI 设计全新病毒基因组，16 种在实验室成功杀死细菌","originalTitle":"","summary":"斯坦福大学与 Arc Institute 团队用 AI 模型 Evo 从零设计完整病毒基因组，并在实验室构建出 16 种自然界不存在的功能性病毒。Evo 提出 70 万个候选基因组，团队仅筛选最有希望的 285 个序列合成并植入细菌，其中 16 个成功复制并杀死宿主。该研究已通过同行评审发表于《Science》，但 Evo 未接受人类病原体数据训练，且能否推广至其他病毒类群仍是未知数。","reason":"","url":"https://aihot.news/items/cmsiys4dz1yqironkuitnfi7t","originalUrl":"https://the-decoder.com/stanford-and-arc-institute-scientists-used-ai-to-design-new-viruses-that-killed-bacteria-in-the-lab","publishedAt":"2026-08-08T00:01:00.022Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1uslcxv","originalSourceName":"The Decoder：AI News（RSS）","family":"outlet-ezirzi","kind":"media","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmsiys4dz1yqironkuitnfi7t","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-07T20:48:56.475Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-1uslcxv","name":"The Decoder：AI News（RSS）","status":"ok","lastSuccessAt":"2026-11-07T20:48:56.475Z"}],"sectionLabel":"论文研究","reportSummary":"斯坦福大学与 Arc Institute 团队用 AI 模型 Evo 从零设计完整病毒基因组，并在实验室构建出 16 种自然界不存在的功能性病毒。Evo 提出 70 万个候选基因组，团队仅筛选最有希望的 285 个序列合成并植入细菌，其中 16 个成功复制并杀死宿主。该研究已通过同行评审发表于《Science》，但 Evo 未接受人类病原体数据训练，且能否推广至其他病毒类群仍是未知数。","reportEdition":"2026-08-08","reportKind":"daily"},{"id":"https://aihot.news/items/cmsiry2eo1r4tronkt9qv2twu","title":"小红书联合浙大、复旦提出 CULTURE-MT：首个面向社媒翻译的「文化有效性」评测基准，入选 ICML 2026","topic":"研究","publishedAt":"2026-08-08T00:01:00.022Z","urls":["https://aihot.news/items/cmsiry2eo1r4tronkt9qv2twu","http