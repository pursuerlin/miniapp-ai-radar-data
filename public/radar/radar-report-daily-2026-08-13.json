":"https://aihot.news/items/cmsqmvjex02jbrow2udzat483","originalUrl":"https://openai.com/index/ringcentral","publishedAt":"2026-08-13T00:00:25.517Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1wljf9q","originalSourceName":"OpenAI：官网动态（RSS · 排除企业/客户案例）","family":"openai","kind":"official","provider":"aihot","category":null,"sectionLabel":"行业动态","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmsqmvjex02jbrow2udzat483","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-07T04:49:10.918Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-1wljf9q","name":"OpenAI：官网动态（RSS · 排除企业/客户案例）","status":"ok","lastSuccessAt":"2026-11-07T04:49:10.918Z"}],"sectionLabel":"行业动态","reportSummary":"RingCentral 通过全员发放 ChatGPT Work 和 Codex，推动从工程到运营的 AI 原生开发，其 AI-Native Challenge 让数千名员工（含非技术人员）交付了可运行项目。","reportEdition":"2026-08-13","reportKind":"daily"},{"id":"https://aihot.news/items/cmsqe6mat01bsroli3hw71nz7","title":"空货架还是丢钥匙？Google 研究：Recall 是参数化事实性的瓶颈","topic":"研究","publishedAt":"2026-08-13T00:00:25.517Z","urls":["https://aihot.news/items/cmsqe6mat01bsroli3hw71nz7","https://research.google/blog/empty-shelves-or-lost-keys-recall-is-the-bottleneck-for-parametric-factuality"],"articles":[{"id":"cmsqe6mat01bsroli3hw71nz7","title":"空货架还是丢钥匙？Google 研究：Recall 是参数化事实性的瓶颈","originalTitle":"","summary":"Google Research 提出知识画像框架，发现前沿 LLM（如 Gemini3、GPT-5）的事实编码接近饱和，但回忆（recall）能力不足，多数事实错误源于“丢钥匙”而非“空货架”。该框架将事实分为编码失败、回忆失败等五类画像，并配套推出 WikiProfile 基准，含 2,150 条维基百科事实，每条配 10 个问题，用于分别探测编码、回忆与识别能力。","reason":"","url":"https://aihot.news/items/cmsqe6mat01bsroli3hw71nz7","originalUrl":"https://research.google/blog/empty-shelves-or-lost-keys-recall-is-the-bottleneck-for-parametric-factuality","publishedAt":"2026-08-13T00:00:25.517Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-u8es94","originalSourceName":"Google Research：Blog（网页）","family":"google","kind":"media","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmsqe6mat01bsroli3hw71nz7","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-07T04:49:10.918Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-u8es94","name":"Google Research：Blog（网页）","status":"ok","lastSuccessAt":"2026-11-07T04:49:10.918Z"}],"sectionLabel":"论文研究","reportSummary":"Google Research 提出知识画像框架，发现前沿 LLM（如 Gemini3、GPT-5）的事实编码接近饱和，但回忆（recall）能力不足，多数事实错误源于“丢钥匙”而非“空货架”。该框架将事实分为编码失败、回忆失败等五类画像，并配套推出 WikiProfile 基准，含 2,150 条维基百科事实，每条配 10 个问题，用于分别探测编码、回忆与识别能力。","reportEdition":"2026-08-13","reportKind":"daily"},{"id":"https://aihot.news/items/cmsqcs2m402xzroosy1xpgvm0","title":"Anthropic 联合独立研究者发布工人再培训项目证据综述","topic":"研究","publishedAt":"2026-08-13T00:00:25.517Z","urls":["https://aihot.news/items/cmsqcs2m402xzroosy1xpgvm0","https://www.anthropic.com/research/reviewing-the-evidence-on-worker-retraining-programs"],"articles":[{"id":"cmsqcs2m402xzroosy1xpgvm0","title":"Anthropic 联合独立研究者发布工人再培训项目证据综述","originalTitle":"","summary":"Anthropic 与独立研究者 David Roodman 合作发布报告，基于 56 项美国随机研究和欧洲实验证据，评估工人再培训项目应对 AI 劳动力市场冲击的效果。","reason":"","url":"https://aihot.news/items/cmsqcs2m402xzroosy1xpgvm0","originalUrl":"https://www.anthropi