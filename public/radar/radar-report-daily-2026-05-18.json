//aihot.news/items/cmp9hwi0k0r0dslnzgpk9c6x0","https://x.com/rohanpaul_ai/status/2055919204591902771"],"articles":[{"id":"cmp9hwi0k0r0dslnzgpk9c6x0","title":"研究揭示LLM智能体记忆重写机制损害可靠性","originalTitle":"","summary":"伊利诺伊大学与清华大学等机构的研究发现，LLM智能体虽能从经验中学习，但其通过LLM将原始经历压缩成书面教训的记忆重写机制会损害记忆可靠性。在网页购物、模拟世界及ARC风格谜题等任务测试中，反复重写记忆会导致错误分组、规则过度泛化或过拟合，使智能体遗忘细节或混淆任务类型。例如，GPT-4在无记忆时可100%解决小型ARC-AGI问题集，而建立记忆并流式更新后，性能降至约54%。研究主张智能体记忆系统应重视原始经历作为关键证据，而非自动将所有经验重写为摘要，保留原始证据并选择性摘要效果更佳。","reason":"","url":"https://aihot.news/items/cmp9hwi0k0r0dslnzgpk9c6x0","originalUrl":"https://x.com/rohanpaul_ai/status/2055919204591902771","publishedAt":"2026-05-18T00:00:00.933Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1sngkqe","originalSourceName":"X：Rohan Paul (@rohanpaul_ai)","family":"outlet-1lanm2l","kind":"community","provider":"aihot","category":null,"sectionLabel":"论文研究","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmp9hwi0k0r0dslnzgpk9c6x0","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-13T10:49:12.006Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-1sngkqe","name":"X：Rohan Paul (@rohanpaul_ai)","status":"ok","lastSuccessAt":"2026-11-13T10:49:12.006Z"}],"sectionLabel":"论文研究","reportSummary":"伊利诺伊大学与清华大学等机构的研究发现，LLM智能体虽能从经验中学习，但其通过LLM将原始经历压缩成书面教训的记忆重写机制会损害记忆可靠性。在网页购物、模拟世界及ARC风格谜题等任务测试中，反复重写记忆会导致错误分组、规则过度泛化或过拟合，使智能体遗忘细节或混淆任务类型。例如，GPT-4在无记忆时可100%解决小型ARC-AGI问题集，而建立记忆并流式更新后，性能降至约54%。研究主张智能体记忆系统应重视原始经历作为关键证据，而非自动将所有经验重写为摘要，保留原始证据并选择性摘要效果更佳。","reportEdition":"2026-05-18","reportKind":"daily"},{"id":"https://aihot.news/items/cmp976l4m0ojjslnzqoaxuhwd","title":"Anthropic CEO预言软件免费化与职业结构巨变","topic":"开发","publishedAt":"2026-05-18T00:00:00.933Z","urls":["https://aihot.news/items/cmp976l4m0ojjslnzqoaxuhwd","https://x.com/rohanpaul_ai/status/2055841486714147177"],"articles":[{"id":"cmp976l4m0ojjslnzqoaxuhwd","title":"Anthropic CEO预言软件免费化与职业结构巨变","originalTitle":"","summary":"Anthropic CEO Dario Amodei在《华尔街日报》YouTube频道采访中表示，软件成本将急剧下降，可能基本免费，传统软件需百万用户分摊成本的前提将不再成立。同时，数十年来建立的许多工作和职业可能消失。Amodei认为社会能够应对并适应这种变化，但他警告人们目前完全未意识到即将到来的变革及其巨大规模。","reason":"","url":"https://aihot.news/items/cmp976l4m0ojjslnzqoaxuhwd","originalUrl":"https://x.com/rohanpaul_ai/status/2055841486714147177","publishedAt":"2026-05-18T00:00:00.933Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1sngkqe","originalSourceName":"X：Rohan Paul (@rohanpaul_ai)","family":"outlet-1lanm2l","kind":"community","provider":"aihot","category":null,"sectionLabel":"技巧与观点","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmp976l4m0ojjslnzqoaxuhwd","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-13T10:49:12.006Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-1sngkqe","name":"X：Rohan Paul (@rohanpaul_ai)","status":"ok","lastSuccessAt":"2026-11-13T10:49:12.006Z"}],"sectionLabel":"技巧与观点","reportSummary":"Anthropic CEO Dario Amodei在《华尔街日报》YouTube频道采访中表示，软件成本将急剧下降，可能基本免费，传统软件需百万用户分摊成本的前提将不再成立。同时，数十年来建立的许多工作和职业可能消失。Amodei认为社会能够应对并适应这种变化，但他警告人们目前完全未意识到即将到来的变革及其巨大规模。","reportEdition":"2026-05-18","reportKind":"daily"},{"id":"https://aihot.news/items/cmp9j4c1f0r98slnzflwtutkd","title":"生成式AI的幻觉、超大规模投入的狂热与世界模型及神经符号AI的路径","topic":"开发","publishedAt":"2026-05-18T00:00:00.933Z","urls":["https://aihot.news/items/cmp9j4c1f0r98slnzflwtutkd","https://garymarcus.substack.com/p/the-illusion-of-generative-ai-the"],"articles":[{"id":"cmp9j4c1f0r98slnzflwtutkd","title":"生成式AI的幻觉、超大规模投入的狂热与世界模型及神经符号AI的路径","originalTitle":"","summary":"近期访谈指出，当前大语言模型存在“幻觉”问题，答案常不可靠。业界对“超大规模”的巨额投入可能陷入非理性狂热。作为替代路径，“世界模型”旨在让AI理解物理规律，“神经符号AI”则尝试结合深度学习与符号推理，以提升可靠性、可解释性与逻辑能力，为下一代AI奠定基础。","reason":"","url":"https://aihot.news/items/cmp9j4c1f0r98slnzflwtutkd","originalUrl":"https://garymarcus.substack.com/p/the-illusion-of-generative-ai-the","publishedAt":"2026-05-18T00:00:00.933Z","sourcePublishedAt":null,"discoveredAt":null,"datePrecision":"report","sourceId":"aihot-1b4wzwz","originalSourceName":"Gary Marcus：The Road to AI We Can Trust（RSS）","family":"outlet-a0gkqk","kind":"media","provider":"aihot","category":null,"sectionLabel":"技巧与观点","selected":false,"contentMode":"licensed-summary","contentType":"news","translationStatus":"original","evidenceRole":"discovery","rights":{"licenseId":"LicenseRef-AIHOT-Written-Permission","permissionId":"aihot-mojing-written-2026-11-04","provider":"aihot","scope":"text-summary","evidenceUrl":"https://aihot.news/items/cmp9j4c1f0r98slnzflwtutkd","licenseUrl":"https://aihot.news/terms","checkedAt":"2026-11-13T10:49:12.006Z","attribution":"导读来源：AIHOT；原报道权利归原作者","modified":"保留 AIHOT 原摘要，未二次改写"}}],"familyCount":0,"mergeReasons":[],"selectionReasons":[],"provider":"aihot","sourceStates":[{"id":"aihot-1b4wzwz","name":"Gary Marcus：The Road to AI We Can Trust（RSS）","status":"ok","lastSuccessAt":"2026-11-13T10:49:12.006Z"}],"sectionLabel":"技巧与观点","reportSummary":"近期访谈指出，当前大语言模型存在“幻觉”问题，答案常不可靠。业界对“超大规模”的巨额投入可能陷入非理性狂热。作为替代路径，“世界模型”旨在让AI理解物理规律，“神经符号AI”则尝试结合深度学习与符号推理，以提升可靠性、可解释性与逻辑能力，为下一代AI奠定基础。","reportEdition":"2026-05-18","reportKind":"daily"}],"total":5,"partial":false,"itemSourceCount":4,"topics":[{"topic":"应用","count":2},{"topic":"研究","count":1},{"topic":"开发","count":2}],"method":"AIHOT 提供选题、摘要与编排；模境保留来源与报告窗口，关